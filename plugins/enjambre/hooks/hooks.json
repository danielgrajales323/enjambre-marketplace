{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-prod.mjs"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-reservado.mjs"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-escrituras.mjs"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-gasto.mjs"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-mapa.mjs", "pre"], "timeout": 10, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-mapa.mjs", "post"], "timeout": 10 }
        ]
      }
    ]
  }
}
